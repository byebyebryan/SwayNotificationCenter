# Bryan's pinned SwayNC fork, built from its published source commit.
pkgname=swaync-bryan
pkgver=0.12.6
pkgrel=8
_commit=91ae6a364df0a5170081491cfd49fa4c3b7df945
pkgdesc="Bryan's SwayNC fork with checked notification actions and a live system dashboard"
arch=('x86_64')
url='https://github.com/byebyebryan/SwayNotificationCenter'
license=('GPL-3.0-only')
depends=('gtk4' 'gtk4-layer-shell' 'libadwaita' 'glib2' 'libgee' 'json-glib' 'libpulse' 'granite7')
makedepends=('vala' 'meson' 'scdoc' 'sassc' 'gobject-introspection' 'blueprint-compiler')
optdepends=('gvfs: Get album art in MPRIS widget'
            'nvidia-utils: NVIDIA dashboard metrics for already active GPUs')
provides=("swaync=${pkgver}")
conflicts=('swaync')
source=("SwayNotificationCenter-${_commit}.tar.gz::${url}/archive/${_commit}.tar.gz")
sha256sums=('141cc7ba83aab6433c310c1d943c5e4761d710ff2d676e9020ecae787fa98cf4')
build() {
    arch-meson "SwayNotificationCenter-${_commit}" build -Dscripting=true
    meson compile -C build
}
check() {
    meson test -C build --print-errorlogs
}
package() {
    DESTDIR="$pkgdir" meson install -C build
    install -Dm644 "SwayNotificationCenter-${_commit}/README.md" "$pkgdir/usr/share/doc/swaync/README.md"
}
